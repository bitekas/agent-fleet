{
  "schema": 1,
  "name": "slack",
  "status": "working",
  "line_prefix": "SLACK",
  "kinds": ["channel", "dm", "thread"],
  "ids": { "user": "^U[A-Z0-9]{6,}$",
           "conversation": "^[CDG][A-Z0-9]{2,20}$",
           "message": "^[0-9]{9,10}\\.[0-9]{6}$" },
  "watch": { "script": "watch.py", "job": "slack-watch", "config_env": "SLACK_WATCH_CONFIG",
             "follow_include": "^SLACK |^DAEMON-|WATCH-GUARD|WATCH-INFO|Traceback|WATCH-ERROR (discovery|dm-discovery)|WATCH-ERROR (?!.*429)" }
}
